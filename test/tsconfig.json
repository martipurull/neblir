{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noEmit": true,
    "paths": {
      "@/app/api/*/route": ["./types/routes.d.ts"],
      "@/*": ["../src/*"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["**/*.ts", "types/**/*.d.ts"],
  "exclude": ["../node_modules"]
}
